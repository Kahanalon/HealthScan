# Database
POSTGRES_DB=healthscan
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Connection string for .NET
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=healthscan;Username=postgres;Password=your_secure_password_here

# Azure OCR (optional - required for OCR features)
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_key_here

# API settings
ASPNETCORE_ENVIRONMENT=Development
