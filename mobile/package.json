{
  "name": "healthscan-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typescript": "tsc --noEmit",
    "generate-api": "openapi-typescript-codegen --input ../contracts/openapi.json --output ./src/infrastructure/api/generated --client axios --useOptions --useUnionTypes",
    "generate-api:fetch": "curl -s http://localhost:5000/swagger/v1/swagger.json -o ../contracts/openapi.json && npm run generate-api"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.27.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.0",
    "@tanstack/react-query": "^5.60.0",
    "axios": "^1.7.0",
    "i18next": "^23.0.0",
    "react": "18.3.1",
    "react-i18next": "^14.0.0",
    "react-native": "0.76.6",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-screens": "^4.9.0",
    "react-native-vision-camera": "^4.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-decorators": "^7.28.6",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^15.0.1",
    "@react-native/babel-preset": "0.76.6",
    "@react-native/eslint-config": "0.76.6",
    "@react-native/metro-config": "0.76.6",
    "@react-native/typescript-config": "0.76.6",
    "@testing-library/jest-native": "^5.4.0",
    "@testing-library/react-native": "^12.8.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.3.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
